# Copy to .env (git-ignored). Spring Boot loads it automatically.
GOOGLE_API_KEY=
AGENT_MODEL=gemini-3.1-flash-lite
AGENT_PORT=8085
# Fault injection + /test/reset. Set false for anything shared/production-like.
AGENT_FAULTS_ENABLED=true
# Arize Phoenix OTLP endpoint (docker compose up -d). Leave empty to disable export.
OTLP_ENDPOINT=http://localhost:6006/v1/traces
# RAG vector store: pgvector (PostgreSQL) or in-memory
RAG_STORE=pgvector
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432
PGVECTOR_DB=rag_db
PGVECTOR_USER=rag_user
PGVECTOR_PASSWORD=
PGVECTOR_TABLE=shopping_policy_embeddings
# true = clear + re-embed policies on every start (no duplicates)
PGVECTOR_REINGEST=true
